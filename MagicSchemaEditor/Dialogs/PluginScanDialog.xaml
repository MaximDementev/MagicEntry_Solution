<Window x:Class="MagicEntry.SchemaEditor.Dialogs.PluginScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сканирование плагинов"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <!-- Применяем трехсекционную структуру по стандарту UI -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок и путь -->
            <RowDefinition Height="*"/>
            <!-- Таблица плагинов -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
        </Grid.RowDefinitions>

        <!-- Секция выбора пути для сканирования -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Выберите папку для сканирования плагинов:"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="txtPath"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Content="Обзор..."
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="BtnBrowse_Click"/>

                <Button Grid.Column="2"
                        x:Name="btnScan"
                        Content="Сканировать"
                        Width="120"
                        Height="30"
                        Click="BtnScan_Click"/>
            </Grid>
        </Grid>

        <!-- Основная таблица найденных плагинов -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      x:Name="dgvPlugins"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <!-- Колонка выбора -->
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40"/>

                    <!-- Название сборки -->
                    <DataGridTextColumn Header="Сборка"
                                        Binding="{Binding AssemblyName}"
                                        Width="*"
                                        IsReadOnly="True"/>

                    <!-- Имя класса -->
                    <DataGridTextColumn Header="Класс"
                                        Binding="{Binding ClassName}"
                                        Width="2*"
                                        IsReadOnly="True"/>

                    <!-- Отображаемое имя -->
                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding DisplayName}"
                                        Width="*"
                                        IsReadOnly="True"/>

                    <!-- Описание -->
                    <DataGridTextColumn Header="Описание"
                                        Binding="{Binding Description}"
                                        Width="2*"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Статус и прогресс-бар -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="lblStatus"
                           Text="Готов к сканированию"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ProgressBar Grid.Column="1"
                             x:Name="progressBar"
                             Height="20"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Панель кнопок управления по стандарту -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопки выбора слева -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button x:Name="btnSelectAll"
                        Content="Выбрать все"
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="BtnSelectAll_Click"/>

                <Button x:Name="btnSelectNone"
                        Content="Снять выбор"
                        Width="100"
                        Height="30"
                        IsEnabled="False"
                        Click="BtnSelectNone_Click"/>
            </StackPanel>

            <!-- Кнопки действия справа -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="btnImport"
                        Content="Импорт"
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="BtnImport_Click"/>

                <Button Content="Отмена"
                        Width="100"
                        Height="30"
                        IsCancel="True"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
