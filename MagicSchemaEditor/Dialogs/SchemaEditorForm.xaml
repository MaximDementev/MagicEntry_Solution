<Window x:Class="MagicEntry.SchemaEditor.SchemaEditorForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор схемы MagicEntry"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1200"
        MinHeight="700">

    <Window.Resources>
        <!-- Добавлены стили для включенных плагинов и drag-over состояния -->
        <Style x:Key="PluginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для панелей с поддержкой перетаскивания -->
        <Style x:Key="PanelGroupStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="DragOver">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Основная сетка -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Validation Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Панель инструментов с поиском и фильтрами -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Редактор конфигурации MagicEntry_Schema.xml"
                           FontSize="14" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtSearch" Width="250" Height="25" VerticalAlignment="Center" 
                             TextChanged="TxtSearch_TextChanged"/>

                    <TextBlock Text="Фильтр Tab:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <ComboBox x:Name="cmbFilterTab" Width="150" Height="25" 
                              SelectionChanged="CmbFilterTab_SelectionChanged"/>

                    <CheckBox x:Name="chkShowDisabled" Content="Показать выключенные" 
                              VerticalAlignment="Center" Margin="15,0,0,0" IsChecked="True"
                              Checked="ChkShowDisabled_CheckedChanged" 
                              Unchecked="ChkShowDisabled_CheckedChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент с вкладками (Plugins первая) -->
        <TabControl Grid.Row="1" Margin="10,10,10,0" x:Name="mainTabControl">

            <!-- Вкладка Plugins - новый дизайн с карточками -->
            <TabItem Header="Plugins">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="300"/>
                        <!-- Добавлен разделитель и колонка для SubCommands -->
                        <ColumnDefinition Width="0" x:Name="subCommandsSplitterColumn"/>
                        <ColumnDefinition Width="0" x:Name="subCommandsColumn"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть - группировка плагинов по панелям -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pluginGroupsContainer" Margin="5"/>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

                    <!-- Свойства плагина теперь на всю высоту -->
                    <GroupBox Grid.Column="2" Header="Свойства плагина" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="propertyGridPlugins" Margin="5"/>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- SubCommands теперь в отдельной правой панели -->
                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CCCCCC" 
                                  x:Name="subCommandsSplitter" Visibility="Collapsed"/>

                    <Grid Grid.Column="4" x:Name="subCommandsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <!-- Made heights equal for both GroupBoxes -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Список подкоманд -->
                        <GroupBox Grid.Row="0" Header="Подкоманды (SplitButton)" Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="subCommandsContainer" Margin="5"/>
                            </ScrollViewer>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

                        <!-- Свойства подкоманды -->
                        <GroupBox Grid.Row="2" Header="Свойства подкоманды" Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="propertyGridSubCommands" Margin="5"/>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка PulldownButton Definitions - карточки вместо таблицы -->
            <TabItem Header="PulldownButton Definitions">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список pulldown карточками -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pulldownCardsContainer" Margin="5"/>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

                    <!-- Свойства pulldown -->
                    <GroupBox Grid.Column="2" Header="Свойства PulldownButton" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="propertyGridPulldown" Margin="5"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Validation Panel - нижняя панель с collapse/expand -->
        <Border Grid.Row="2" x:Name="validationPanel" 
                Background="#FFFEF5" 
                BorderBrush="#FFA500" 
                BorderThickness="0,2,0,0" 
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#FFE5CC" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚠ Ошибки валидации" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <Button Grid.Column="2" Content="▲ Свернуть" Width="100" Height="25" 
                            Margin="0,0,5,0" x:Name="btnCollapseValidation" 
                            Click="BtnCollapseValidation_Click"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="lstValidationErrors" Margin="10" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Панель кнопок - sticky footer -->
        <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnScanPlugins" Content="Сканировать..." Width="120" Height="30" Margin="0,0,10,0"
                            Click="BtnScanPlugins_Click"/>
                    <Button x:Name="btnToggleValidation" Content="Показать ошибки" Width="150" Height="30"
                            Click="BtnToggleValidation_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtStatus" Text="" VerticalAlignment="Center" Margin="0,0,20,0" FontStyle="Italic"/>

                    <Button Content="Сохранить (Ctrl+S)" Width="130" Height="30" Margin="0,0,10,0"
                            IsDefault="True" Click="BtnSave_Click"/>

                    <Button Content="Закрыть" Width="100" Height="30"
                            IsCancel="True" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
